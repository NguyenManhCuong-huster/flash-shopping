# ===== Server =====
# Cổng bên trong container (giữ 3000). Cổng mở ra máy host chỉnh bằng API_HOST_PORT.
PORT=3000
API_HOST_PORT=3001
DB_HOST_PORT=5433
MAILPIT_UI_PORT=8025
NODE_ENV=production
# Cho phép CORS (dấu * = mọi nguồn). Ứng dụng di động không cần CORS.
CORS_ORIGIN=*

# ===== Database (docker-compose tự ghi đè DATABASE_URL cho container api) =====
POSTGRES_DB=dicho
POSTGRES_USER=dicho
POSTGRES_PASSWORD=dicho
DATABASE_URL=postgres://dicho:dicho@localhost:5433/dicho

# ===== Xác thực =====
# BẮT BUỘC đổi khi triển khai thật: chuỗi ngẫu nhiên >= 32 ký tự
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-string-123456
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=10

# Tài khoản quản trị hệ thống được tạo tự động khi khởi động (nếu chưa có)
ADMIN_EMAIL=admin@dicho.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Quản trị viên

# ===== Email (mặc định gửi vào Mailpit trong docker-compose) =====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Đi chợ tiện lợi <no-reply@dicho.local>"

# ===== Lưu trữ ảnh =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ===== Nhắc hạn sử dụng (UC06) =====
EXPIRY_REMINDER_DAYS=3
# Biểu thức cron (mặc định mỗi 30 phút)
EXPIRY_JOB_CRON=*/30 * * * *
PUSH_RETRY_LIMIT=3

# Push qua Firebase Cloud Messaging HTTP v1. Để trống => chỉ ghi log + lưu hộp thư trong ứng dụng.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# ===== Trợ lý AI (mô-đun AI Agent) =====
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# Độ sâu suy luận: low | medium | high | xhigh | max (chat thường dùng low/medium)
AI_EFFORT=medium
# Để trống => các API ai/chat trả mã 00413 (dịch vụ AI không khả dụng)
AI_API_KEY=
AI_MAX_TOOL_CALLS=8
AI_TURN_TIMEOUT_SECONDS=60
